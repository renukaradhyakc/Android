<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    tools:context=".ActivityCall">

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/blue"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_inner_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/palette"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/text_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/circle_avatar_background_1"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="R"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold|italic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="serif"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="Renukaradhya K C"
                android:textColor="#1E3A8A"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                android:gravity="center_horizontal"
                app:layout_constraintEnd_toStartOf="@id/button_close"
                app:layout_constraintStart_toEndOf="@id/text_avatar"
                app:layout_constraintTop_toTopOf="@id/text_avatar"
                app:layout_constraintVertical_chainStyle="packed" />

            <ImageButton
                android:id="@+id/button_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/stats_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/text_avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/contact_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/contact_badge_view"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/contact_badge_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not in Contacts"
                        android:textColor="#FF4D4D"
                        android:textSize="10sp" android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/callalink_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/callalink_badge_view"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/callalink_badge_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Non-CallaLink User"
                        android:textColor="#FF4D4D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/outside_schedule_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/outside_schedule_badge_view"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/outside_schedule_badge_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outside-schedule"
                        android:textColor="#FF4D4D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/model_label"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unrestricted Mode"
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stats_row"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_branding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text="callalink"
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stats_row" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/links_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/model_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
