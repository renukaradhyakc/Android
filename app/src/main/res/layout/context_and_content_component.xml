<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_story_avatar"
    android:layout_width="70dp"
    android:layout_height="100dp"
    android:layout_marginHorizontal="4dp"
    android:padding="4dp"
    android:foreground="?android:attr/selectableItemBackgroundBorderless">

    <!-- Outer Glow / Ring -->
    <View
        android:id="@+id/avatar_ring"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/avatar_glow_ring"
        android:elevation="3dp" />

    <!-- Avatar Container -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:clipToOutline="true"
        android:background="@drawable/circle_avatar_background"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Story avatar" />
    </FrameLayout>

    <!-- Name below avatar -->
    <TextView
        android:id="@+id/avatar_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:text="Posts"
        android:textColor="#EAE8FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</FrameLayout>
